:root {
  --background: #050508;
  --panel: #0b0d14;
  --panel-soft: #111522;
  --cyan: #22d3ee;
  --violet: #8b5cf6;
  --pink: #d946ef;
  --text: #f8fafc;
  --muted: #94a3b8;
  --line: rgba(255, 255, 255, 0.12);
  --success: #34d399;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  background: var(--background);
}

* { box-sizing: border-box; }

body {
  min-width: 320px;
  margin: 0;
  background:
    radial-gradient(circle at 15% 0%, rgba(34, 211, 238, 0.09), transparent 30%),
    radial-gradient(circle at 90% 12%, rgba(139, 92, 246, 0.11), transparent 34%),
    var(--background);
}

button,
input { font: inherit; }

button { cursor: pointer; }

.manager-header {
  position: sticky;
  z-index: 20;
  top: 0;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 18px;
  align-items: center;
  min-height: 82px;
  padding: 12px 28px;
  border-bottom: 1px solid var(--line);
  background: rgba(5, 5, 8, 0.88);
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(22px);
}

.manager-header > img {
  width: 64px;
  height: 56px;
  border: 1px solid rgba(34, 211, 238, 0.25);
  border-radius: 50%;
  object-fit: cover;
  box-shadow: 0 0 28px rgba(34, 211, 238, 0.2);
}

.manager-header__title { display: grid; gap: 2px; }

.manager-header__title span,
.section-heading p,
.search-field span,
.manager-summary span {
  color: var(--cyan);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.manager-header__title strong { font-size: 22px; }

.manager-header__status {
  display: flex;
  gap: 8px;
  align-items: center;
  color: #cbd5e1;
  font-size: 13px;
  font-weight: 800;
}

.manager-header__status i {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 14px rgba(52, 211, 153, 0.7);
}

.manager-shell {
  width: min(1500px, calc(100% - 32px));
  margin: 18px auto 40px;
}

.manager-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 180px)) minmax(160px, 1fr) minmax(190px, 1fr);
  gap: 1px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--line);
  box-shadow: 0 0 50px rgba(34, 211, 238, 0.05);
}

.manager-summary div,
.manager-summary button {
  min-height: 76px;
  border: 0;
  padding: 14px 18px;
  background: rgba(11, 13, 20, 0.95);
  color: var(--text);
}

.manager-summary div { display: grid; gap: 4px; }
.manager-summary strong { font-size: 27px; }
.manager-summary button { justify-self: stretch; font-weight: 900; text-align: right; }
.manager-summary button:hover { color: var(--cyan); }
.manager-summary .manager-summary__deploy {
  background: linear-gradient(90deg, rgba(124, 58, 237, 0.95), rgba(34, 211, 238, 0.92));
  color: #fff;
  text-align: center;
}
.manager-summary .manager-summary__deploy:hover { color: #fff; filter: brightness(1.08); }
.manager-summary button:disabled { cursor: wait; opacity: 0.65; }

.manager-layout {
  display: grid;
  grid-template-columns: minmax(520px, 1.15fr) minmax(440px, 0.85fr);
  gap: 18px;
  align-items: start;
  margin-top: 18px;
}

.product-browser,
.photo-workspace {
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(11, 13, 20, 0.94);
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
}

.product-browser { min-width: 0; padding: 22px; }
.section-heading { display: flex; justify-content: space-between; gap: 16px; align-items: end; }
.section-heading p,
.section-heading h1 { margin: 0; }
.section-heading h1 { margin-top: 4px; font-size: 30px; }
.section-heading > span { color: var(--muted); font-size: 13px; font-weight: 700; }

.search-field { display: grid; gap: 7px; margin-top: 20px; }

.search-field input {
  width: 100%;
  min-height: 48px;
  border: 1px solid rgba(34, 211, 238, 0.28);
  border-radius: 14px;
  padding: 0 14px;
  outline: 0;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
}

.search-field input::placeholder { color: #64748b; }
.search-field input:focus { border-color: var(--cyan); box-shadow: 0 0 24px rgba(34, 211, 238, 0.12); }

.mode-switch { display: flex; gap: 8px; margin-top: 12px; }

.mode-switch button {
  min-height: 38px;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 0 13px;
  background: rgba(255, 255, 255, 0.035);
  color: #cbd5e1;
  font-size: 13px;
  font-weight: 900;
}

.mode-switch button.is-active {
  border-color: rgba(34, 211, 238, 0.52);
  background: rgba(34, 211, 238, 0.11);
  color: #a5f3fc;
  box-shadow: 0 0 22px rgba(34, 211, 238, 0.08);
}

.product-list {
  display: grid;
  gap: 8px;
  max-height: calc(100vh - 330px);
  min-height: 420px;
  margin-top: 16px;
  overflow-y: auto;
  padding-right: 5px;
}

.product-row {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  width: 100%;
  min-height: 72px;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 7px 10px;
  background: rgba(255, 255, 255, 0.025);
  color: inherit;
  text-align: left;
}

.product-row:hover,
.product-row.is-selected {
  border-color: rgba(34, 211, 238, 0.55);
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.09), rgba(139, 92, 246, 0.07));
}

.product-row__visual {
  display: grid;
  width: 56px;
  height: 56px;
  place-items: center;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  background: #050508;
}

.product-row__visual img { width: 100%; height: 100%; object-fit: contain; }
.product-row__visual img.is-mark { width: 42px; height: 42px; border-radius: 50%; opacity: 0.5; object-fit: cover; }
.product-row__text { min-width: 0; }
.product-row__text strong,
.product-row__text span { display: block; }
.product-row__text strong { overflow: hidden; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
.product-row__text span { margin-top: 5px; color: var(--muted); font-size: 12px; }

.status-chip {
  border-radius: 999px;
  padding: 6px 8px;
  background: rgba(255, 255, 255, 0.08);
  color: #cbd5e1;
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.status-chip--pending { background: rgba(139, 92, 246, 0.16); color: #ddd6fe; }
.photo-workspace { position: sticky; top: 100px; min-height: 610px; overflow: hidden; }

.workspace-empty,
.workspace-busy {
  display: grid;
  min-height: 608px;
  place-content: center;
  justify-items: center;
  padding: 40px;
  text-align: center;
}

.workspace-empty img { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; opacity: 0.6; }
.workspace-empty h2,
.workspace-empty p,
.workspace-busy strong,
.workspace-busy p { margin: 14px 0 0; }
.workspace-empty p,
.workspace-busy p { max-width: 390px; color: var(--muted); line-height: 1.5; }
.workspace-content { padding: 22px; }
.workspace-title p,
.workspace-title h2 { margin: 0; }
.workspace-title p { color: var(--cyan); font-size: 12px; font-weight: 900; text-transform: uppercase; }
.workspace-title h2 { margin-top: 6px; font-size: 25px; line-height: 1.08; }
.workspace-title small { display: block; margin-top: 8px; color: var(--muted); }

.preview-stage {
  position: relative;
  display: grid;
  min-height: 350px;
  margin-top: 18px;
  place-items: center;
  overflow: hidden;
  border: 1px solid rgba(34, 211, 238, 0.18);
  border-radius: 18px;
  background:
    radial-gradient(circle at center, rgba(34, 211, 238, 0.12), transparent 55%),
    linear-gradient(135deg, #0c1019, #050508 62%, #130d22);
}

.preview-stage::after {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 82% 20%, rgba(139, 92, 246, 0.15), transparent 30%);
  content: "";
}

.preview-stage img {
  position: relative;
  z-index: 1;
  width: min(100%, 430px);
  height: 340px;
  object-fit: contain;
}

.preview-stage img.is-placeholder { width: 124px; height: 124px; border-radius: 50%; opacity: 0.48; object-fit: cover; }

.review-box {
  margin-top: 14px;
  border-left: 4px solid #f59e0b;
  border-radius: 10px;
  padding: 12px 14px;
  background: rgba(245, 158, 11, 0.1);
  color: #fde68a;
  font-size: 13px;
  line-height: 1.45;
}

.review-box--ready { border-left-color: var(--success); background: rgba(52, 211, 153, 0.09); color: #a7f3d0; }
.review-box strong { display: block; margin-bottom: 4px; }

.drop-zone {
  display: grid;
  gap: 5px;
  margin-top: 14px;
  border: 2px dashed rgba(148, 163, 184, 0.36);
  border-radius: 16px;
  padding: 18px;
  background: rgba(255, 255, 255, 0.025);
  text-align: center;
}

.drop-zone.is-dragging { border-color: var(--cyan); background: rgba(34, 211, 238, 0.08); }
.drop-zone strong { font-size: 14px; }
.drop-zone span { color: var(--muted); font-size: 12px; }
.workspace-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin-top: 14px; }

.manager-button {
  display: inline-flex;
  min-height: 45px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 13px;
  padding: 9px 13px;
  background: rgba(255, 255, 255, 0.045);
  color: var(--text);
  font-weight: 900;
  text-decoration: none;
}

.manager-button:hover { border-color: rgba(34, 211, 238, 0.5); }
.manager-button--primary { border-color: transparent; background: linear-gradient(90deg, var(--violet), #3b82f6, var(--cyan)); color: #fff; box-shadow: 0 0 26px rgba(34, 211, 238, 0.15); }
.manager-button--quiet { border-color: rgba(244, 63, 94, 0.25); color: #fda4af; }
.workspace-busy[hidden],
.workspace-content[hidden],
.workspace-empty[hidden],
.manager-toast[hidden] { display: none; }

.spinner {
  width: 42px;
  height: 42px;
  border: 4px solid rgba(139, 92, 246, 0.22);
  border-top-color: var(--cyan);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.manager-toast {
  position: fixed;
  z-index: 50;
  right: 24px;
  bottom: 24px;
  max-width: 440px;
  border: 1px solid rgba(34, 211, 238, 0.28);
  border-radius: 14px;
  padding: 14px 18px;
  background: #101522;
  color: #fff;
  font-weight: 800;
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.45);
}

.manager-toast.is-error { border-color: rgba(244, 63, 94, 0.4); background: #3b1118; }
.empty-list { display: grid; min-height: 300px; place-items: center; color: var(--muted); text-align: center; }

@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 980px) {
  .manager-layout { grid-template-columns: 1fr; }
  .photo-workspace { position: static; }
  .product-list { max-height: 600px; }
}

@media (max-width: 680px) {
  .manager-header { grid-template-columns: auto 1fr; padding: 10px 16px; }
  .manager-header > img { width: 52px; height: 52px; }
  .manager-header__title strong { font-size: 18px; }
  .manager-header__status { display: none; }
  .manager-shell { width: min(100% - 20px, 1500px); }
  .manager-summary { grid-template-columns: repeat(3, 1fr); }
  .manager-summary div,
  .manager-summary button { min-height: 66px; padding: 10px; }
  .manager-summary button { grid-column: 1 / -1; text-align: center; }
  .manager-summary strong { font-size: 22px; }
  .manager-summary span { font-size: 9px; }
  .product-browser,
  .workspace-content { padding: 16px; }
  .mode-switch { display: grid; grid-template-columns: repeat(3, 1fr); }
  .mode-switch button { padding: 0 6px; font-size: 11px; }
  .product-row { grid-template-columns: 50px minmax(0, 1fr); }
  .product-row .status-chip { grid-column: 2; justify-self: start; }
  .workspace-actions { grid-template-columns: 1fr; }
}
